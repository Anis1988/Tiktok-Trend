# ---- Netlify (Site configuration -> Environment variables) ----
APP_ACCESS_TOKEN=            # a password you make up, entered once per device
APP_SECRET=                  # long random text; signs the email review links (same value in GitHub)
GH_DISPATCH_TOKEN=           # GitHub fine-grained token for this repo with Actions: Read and write
GH_REPO=Anis1988/Tiktok-Trend
TIKTOK_CLIENT_KEY=           # later, after TikTok approves the developer app
TIKTOK_CLIENT_SECRET=
GOOGLE_CLIENT_ID=            # optional: YouTube Shorts (Google Cloud OAuth client, YouTube Data API v3)
GOOGLE_CLIENT_SECRET=
META_APP_ID=                 # optional: Facebook & Instagram Reels (developers.facebook.com app)
META_APP_SECRET=
YOUTUBE_API_KEY=             # optional: YouTube trending chart as a topic source (also in GitHub)

# ---- GitHub (repo -> Settings -> Secrets and variables -> Actions) ----
# ANTHROPIC_API_KEY, PIXABAY_API_KEY (or PEXELS_API_KEY), NETLIFY_SITE_ID, NETLIFY_AUTH_TOKEN, APP_SECRET, SITE_URL,
# EMAILJS_SERVICE_ID, EMAILJS_TEMPLATE_ID, EMAILJS_USER_ID, EMAILJS_PRIVATE_KEY,
# TIKTOK_CLIENT_KEY, TIKTOK_CLIENT_SECRET (later), GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET (for YouTube), YOUTUBE_API_KEY (optional)
# Optional repository variable AI_MODEL (default claude-opus-5-5).
